  "yi_jing": {
    "gua_ci": "吉。原筮元永貞，无咎。不寧方來，後夫凶。",
    "yao_ci": [
      {
        "label": "初六",
        "text": "有孚，比之，无咎。有孚盈缶，終來有它，吉。"
      },
      {
        "label": "六二",
        "text": "比之自內，貞吉。"
      },
      {
        "label": "六三",
        "text": "比之匪人。"
      },
      {
        "label": "六四",
        "text": "外比之，貞吉。"
      },
      {
        "label": "九五",
        "text": "顯比。王用三驅，失前禽，邑人不誡，吉。"
      },
      {
        "label": "上六",
        "text": "比之无首，凶。"
      }
    ]
  },
  "tuan": "比，吉也。比，輔也，下順從也。原筮，元永貞，无咎，以剛中也。不寧方來，上下應也。後夫凶，其道窮也。",
  "xiang": {
    "da_xiang": "地上有水，比；先王以建萬國，親諸侯。",
    "xiao_xiang": [
      "比之初六，有它吉也。",
      "比之自內，不自失也。",
      "比之匪人，不亦傷乎！",
      "外比於賢，以從上也。",
      "顯比之吉，位正中也。舍逆取順，失前禽也。邑人不誡，上使中也。",
      "比之无首，无所終也。"
    ]
  }
}