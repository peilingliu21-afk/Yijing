  "yi_jing": {
    "gua_ci": "亨。密雲不雨，自我西郊。",
    "yao_ci": [
      {
        "label": "初九",
        "text": "復自道，何其咎，吉。"
      },
      {
        "label": "九二",
        "text": "牽復，吉。"
      },
      {
        "label": "九三",
        "text": "輿說輻，夫妻反目。"
      },
      {
        "label": "六四",
        "text": "有孚，血去惕出，无咎。"
      },
      {
        "label": "九五",
        "text": "有孚攣如，富以其鄰。"
      },
      {
        "label": "上九",
        "text": "既雨既處，尚德載，婦貞厲，月幾望，君子征凶。"
      }
    ]
  },
  "tuan": "小畜，柔得位而上下應之，曰小畜。健而巽，剛中而志行，乃亨。密雲不雨，尚往也。自我西郊，施未行也。",
  "xiang": {
    "da_xiang": "風行天上，小畜，君子以懿文德。",
    "xiao_xiang": [
      "復自道，其義吉也。",
      "牽復在中，亦不自失也。",
      "夫妻反目，不能正室也。",
      "有孚。惕出。上合志也。",
      "有孚攣如，不獨富也。",
      "既雨既處，德積載也。君子征凶，有所疑也。"
    ]
  }
}