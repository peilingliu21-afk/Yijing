  "yi_jing": {
    "gua_ci": "亨。利用獄。",
    "yao_ci": [
      {
        "label": "初九",
        "text": "屨校滅趾，无咎。"
      },
      {
        "label": "六二",
        "text": "噬膚滅鼻，无咎。"
      },
      {
        "label": "六三",
        "text": "噬臘肉，遇毒；小吝，无咎。"
      },
      {
        "label": "九四",
        "text": "噬乾胏，得金矢，利艱貞，吉。"
      },
      {
        "label": "六五",
        "text": "噬乾肉，得黃金，貞厲，无咎。"
      },
      {
        "label": "上九",
        "text": "何校滅耳，凶。"
      }
    ]
  },
  "tuan": "頤中有物，曰噬嗑，噬嗑而亨。剛柔分，動而明，雷電合而章。柔得中而上行，雖不當位，利用獄也。",
  "xiang": {
    "da_xiang": "雷電噬嗑；先王以明罰敕法。",
    "xiao_xiang": [
      "屨校滅趾，不行也。",
      "噬膚滅鼻，乘剛也。",
      "遇毒，位不當也。",
      "利艱貞吉，未光也。",
      "貞厲无咎，得當也。",
      "何校滅耳，聰不明也。"
    ]
  }
