  "yi_jing": {
    "gua_ci": "亨。出入无疾，朋來无咎。反復其道，七日來復，利有攸往。",
    "yao_ci": [
      {
        "label": "初九",
        "text": "不復遠，无袛悔，元吉。"
      },
      {
        "label": "六二",
        "text": "休復，吉。"
      },
      {
        "label": "六三",
        "text": "頻復，厲无咎。"
      },
      {
        "label": "六四",
        "text": "中行獨復。"
      },
      {
        "label": "六五",
        "text": "敦復，无悔。"
      },
      {
        "label": "上六",
        "text": "迷復，凶，有災眚。用行師，終有大敗，以其國君，凶；至于十年，不克征。"
      }
    ]
  },
  "tuan": "復亨；剛反，動而以順行，是以出入无疾，朋來无咎。反復其道，七日來復，天行也。利有攸往，剛長也。復其見天地之心乎？",
  "xiang": {
    "da_xiang": "雷在地中，復；先王以至日閉關，商旅不行，后不省方。",
    "xiao_xiang": [
      "不遠之復，以修身也。",
      "休復之吉，以下仁也。",
      "頻復之厲，義无咎也。",
      "中行獨復，以從道也。",
      "敦復无悔，中以自考也。",
      "迷復之凶，反君道也。"
    ]
  }
}