  "yi_jing": {
    "gua_ci": "有孚，維心亨。行有尚。",
    "yao_ci": [
      {
        "label": "初六",
        "text": "習坎，入于坎窞，凶。"
      },
      {
        "label": "九二",
        "text": "坎有險，求小得。"
      },
      {
        "label": "六三",
        "text": "來之坎坎，險且枕，入于坎窞，勿用。"
      },
      {
        "label": "六四",
        "text": "樽酒簋貳，用缶，納約自牖，終无咎。"
      },
      {
        "label": "九五",
        "text": "坎不盈，祗既平，无咎。"
      },
      {
        "label": "上六",
        "text": "係用徽纆，寘于叢棘，三歲不得，凶。"
      }
    ]
