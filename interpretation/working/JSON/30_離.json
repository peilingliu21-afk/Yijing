  "yi_jing": {
    "gua_ci": "利貞。亨。畜牝牛，吉。",
    "yao_ci": [
      {
        "label": "初九",
        "text": "履錯然，敬之无咎。"
      },
      {
        "label": "六二",
        "text": "黃離，元吉。"
      },
      {
        "label": "九三",
        "text": "日昃之離，不鼓缶而歌，則大耋之嗟，凶。"
      },
      {
        "label": "九四",
        "text": "突如其來如，焚如，死如，棄如。"
      },
      {
        "label": "六五",
        "text": "出涕沱若，戚嗟若，吉。"
      },
      {
        "label": "上九",
        "text": "王用出征，有嘉折首，獲匪其醜，无咎。"
      }
    ]
  },
  "tuan": "離，麗也；日月麗乎天，百谷草木麗乎土，重明以麗乎正，乃化成天下。柔麗乎中正，故亨；是以畜牝牛吉也。",
  "xiang": {
    "da_xiang": "明兩作離，大人以繼明照于四方。",
    "xiao_xiang": [
      "履錯之敬，以辟咎也。",
      "黃離元吉，得中道也。",
      "日昃之離，何可久也。",
      "突如其來如，无所容也。",
      "六五之吉，離王公也。",
      "王用出征，以正邦也。"
    ]
  }
}