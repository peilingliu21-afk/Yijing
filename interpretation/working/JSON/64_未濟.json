  "yi_jing": {
    "gua_ci": "亨。小狐汔濟，濡其尾，无攸利。",
    "yao_ci": [
      {
        "label": "初六",
        "text": "濡其尾，吝。"
      },
      {
        "label": "九二",
        "text": "曳其輪，貞吉。"
      },
      {
        "label": "六三",
        "text": "未濟，征凶，利涉大川。"
      },
      {
        "label": "九四",
        "text": "貞吉，悔亡，震用伐鬼方，三年有賞于大國。"
      },
      {
        "label": "六五",
        "text": "貞吉，无悔，君子之光，有孚，吉。"
      },
      {
        "label": "上九",
        "text": "有孚于飲酒，无咎，濡其首，有孚失是。"
      }
    ]
